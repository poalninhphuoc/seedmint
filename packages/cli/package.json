{
  "name": "seedmint",
  "version": "0.0.1",
  "description": "Paste a schema, get realistic sample data in any language and format.",
  "license": "MIT",
  "type": "module",
  "bin": { "seedmint": "./dist/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.0",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@seedmint/core": "workspace:*",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "vitest": "^2.0.0"
  }
}
